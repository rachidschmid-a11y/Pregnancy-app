{
  "name": "Unser Nest",
  // Node.js für Firebase-CLI und Tests, Java für den Firestore-Emulator
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "public/index.html"
      ]
    }
  },
  // Firebase-CLI installieren und – falls noch nicht vorhanden – die
  // Zugriffsregeln aus der Vorlage anlegen (nur für den Emulator nötig).
  "postCreateCommand": "npm install -g firebase-tools && cp -n firestore.rules.example firestore.rules && echo '✅ Firebase-CLI installiert'",
  "postAttachCommand": {
    "emulator": "npm start"
  },
  "forwardPorts": [5000, 4000, 8080, 9099],
  "portsAttributes": {
    "5000": { "label": "App (Emulator)", "onAutoForward": "openBrowser" },
    "4000": { "label": "Emulator-Oberfläche" },
    "8080": { "label": "Firestore-Emulator", "onAutoForward": "silent" },
    "9099": { "label": "Auth-Emulator", "onAutoForward": "silent" }
  }
}
